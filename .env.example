# Copy to .env locally. Never commit real tokens.

# Hugging Face (gated Llama-3.1-8B-Instruct). Store in a K8s Secret on GKE.
HF_TOKEN=

# GCP
GOOGLE_CLOUD_PROJECT=
REGION=us-central1
ZONE=us-central1-a
CLUSTER=infergrid
BUCKET=

# Local
INFERGRID_URL=http://127.0.0.1:8080
INFERGRID_ROUTES_PATH=gateway/routes.example.yaml
