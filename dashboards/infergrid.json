{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Requests / s by backend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (backend) (rate(infergrid_gateway_requests_total[1m]))",
          "legendFormat": "{{backend}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Gateway p50 / p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(infergrid_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(infergrid_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(llm_queue_depth) or sum(vllm:num_requests_waiting)", "legendFormat": "waiting" }
      ]
    },
    {
      "id": 4,
      "title": "KV cache usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "llm_kv_cache_usage or vllm:kv_cache_usage_perc", "legendFormat": "kv" }
      ]
    },
    {
      "id": 5,
      "title": "GPU utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}" }
      ]
    },
    {
      "id": 6,
      "title": "Backend replicas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"infergrid\"}",
          "legendFormat": "desired {{deployment}}"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"infergrid\"}",
          "legendFormat": "available {{deployment}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["infergrid", "llm"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Infergrid",
  "uid": "infergrid",
  "version": 1
